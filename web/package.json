{
    "name": "infinite-canvas",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 3000",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "start": "vite preview --host 0.0.0.0 --port 3000",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:3000 && cross-env VITE_DEV=1 electron .\"",
        "electron:build": "cross-env ELECTRON=true vite build && cross-env ELECTRON_CACHE=./.electron-cache electron-builder",
        "electron:dist": "cross-env ELECTRON=true vite build && cross-env ELECTRON_CACHE=./.electron-cache electron-builder --publish never"
    },
    "dependencies": {
        "@ant-design/icons": "^6.1.1",
        "@ant-design/pro-components": "3.0.0-beta.3",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@tanstack/react-query": "^5.100.9",
        "@uiw/react-codemirror": "^4.25.9",
        "antd": "^6.4.2",
        "axios": "^1.16.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^4.0.2",
        "dayjs": "^1.11.20",
        "fflate": "^0.8.3",
        "file-saver": "^2.0.5",
        "i18next": "^26.3.6",
        "localforage": "^1.10.0",
        "lucide-react": "^1.16.0",
        "motion": "^12.38.0",
        "nanoid": "^5.1.11",
        "radix-ui": "^1.4.3",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-i18next": "^17.0.11",
        "react-router": "^7.12.0",
        "react-router-dom": "^7.12.0",
        "shadcn": "^4.7.0",
        "streamdown": "^2.5.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^20",
        "@types/react": "19.1.12",
        "@types/react-dom": "19.1.9",
        "@vitejs/plugin-react": "^5.2.0",
        "concurrently": "^9.1.0",
        "cross-env": "^7.0.3",
        "electron": "^33.0.0",
        "electron-builder": "^25.1.8",
        "prettier": "^3.8.3",
        "typescript": "^5",
        "vite": "^7.3.0",
        "wait-on": "^8.0.1"
    },
    "build": {
        "_comment_appId": "appId 和 productName 是用户数据归属的键，升级版本时切勿修改，否则用户本地的画布、资产、API Key 等数据将丢失",
        "appId": "com.infinite-canvas.app",
        "productName": "InfiniteCanvas",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "asar": true,
        "icon": "build/icon.png",
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "linux": {
            "target": [
                "AppImage"
            ]
        }
    }
}
